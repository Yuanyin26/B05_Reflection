# Local Docker Compose example. No real credentials belong in this template.
# Use explicitly: docker compose --env-file .env.example run --rm --build research
# Host paths are relative to the repository's compose.yaml.
B05_INPUT_DIR=./data/examples
B05_OUTPUT_DIR=./outputs/docker
B05_CONFIG_FILE=./configs/config.example.toml

# Optional runtime override. Empty means: use the TOML setting, then INFO.
B05_LOG_LEVEL=

# Supplied by the authorized runtime. Do not hardcode a gateway, token, or model.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional flags: empty = unspecified; otherwise 0 or 1.
LLM_USE_JSON_SCHEMA=
LLM_ENABLE_THINKING=
